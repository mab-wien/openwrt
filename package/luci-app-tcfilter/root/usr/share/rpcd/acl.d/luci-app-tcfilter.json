{
	"luci-app-tcfilter": {
		"description": "Grant access to the tcfilter configuration and status",
		"read": {
			"uci": [ "tcfilter" ],
			"file": {
				"/sbin/tc": [ "exec" ],
				"/usr/sbin/tc": [ "exec" ],
				"/sys/class/net": [ "list" ]
			}
		},
		"write": {
			"uci": [ "tcfilter" ],
			"file": {
				"/etc/init.d/tcfilter": [ "exec" ]
			},
			"ubus": {
				"rc": [ "init" ]
			}
		}
	}
}
